{
  "name": "placeable-monorepo",
  "private": true,
  "license": "MIT",
  "scripts": {
    "build": "pnpm -r build",
    "test": "pnpm -r test",
    "test:coverage": "pnpm -r test:coverage",
    "test:e2e": "pnpm --filter @placeable-js/core test:e2e",
    "typecheck": "pnpm -r typecheck",
    "lint": "biome check .",
    "format": "biome check --write .",
    "dev": "pnpm --filter @placeable-js/core dev:play",
    "pack:check": "pnpm --filter @placeable-js/core pack:check",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "release": "pnpm build && pnpm test && changeset publish"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.0.0",
    "@changesets/cli": "^2.31.0",
    "@playwright/test": "^1.60.0",
    "@vitest/coverage-v8": "^3.0.0",
    "esbuild": "^0.28.0",
    "tsup": "^8.0.0",
    "typescript": "^5.8.0",
    "vitest": "^3.0.0"
  },
  "packageManager": "pnpm@10.28.2"
}
